# Copia questo file in ".env" e valorizza prima di eseguire "docker compose up"

# --- Database ---
POSTGRES_USER=barmanager
POSTGRES_PASSWORD=change-me
POSTGRES_DB=barmanager
DATABASE_URL=postgresql://barmanager:change-me@postgres:5432/barmanager

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- SMTP (invio ordini/notifiche) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=ordini@example.com
SMTP_PASSWORD=change-me
SMTP_FROM="BarManager <ordini@example.com>"

# --- Frontend ---
VITE_API_URL=http://localhost:3000/api

# --- App ---
NODE_ENV=development
PORT=3000
