# Copia questo file in ".env" e valorizza prima di eseguire "docker compose up"

# --- Database ---
# Non serve impostare DATABASE_URL separatamente: docker-compose.yml la
# costruisce da queste tre variabili (unica fonte di verità per la
# password, evita che backend e postgres finiscano con credenziali
# disallineate dopo un redeploy).
POSTGRES_USER=barmanager
POSTGRES_PASSWORD=change-me
POSTGRES_DB=barmanager

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- SMTP (invio ordini/notifiche) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=ordini@example.com
SMTP_PASSWORD=change-me
SMTP_FROM="BarManager <ordini@example.com>"

# --- Multi-tenant (sotto-domini) ---
# In locale/sviluppo lascia ROOT_DOMAIN vuoto: il TenantMiddleware diventa
# no-op e login/menù funzionano senza sotto-domini (utile con localhost).
# In produzione, usata a runtime dal backend (TenantMiddleware) per
# riconoscere il locale dal sotto-dominio — impostala comunque:
# ROOT_DOMAIN=tuodominio.it
#
# ATTENZIONE: il ROUTING Traefik (label del servizio "frontend" in
# docker-compose.yml) NON legge questa variabile — verificato che Coolify
# non interpola in modo affidabile le variabili dentro "labels:", quindi
# lì il dominio è scritto a mano. Se cambi dominio, valorizza questa
# variabile qui E modifica anche le label in docker-compose.yml.
ROOT_DOMAIN=
ADMIN_SUBDOMAIN=admin

# --- Frontend ---
# Lascia vuoto: il frontend chiama l'API in modo relativo ("/api"), instradata
# dallo stesso proxy (Nginx/Vite) che serve la SPA. Valorizza solo per
# puntare a un backend su un altro host (raro).
VITE_API_URL=

# --- App ---
NODE_ENV=development
PORT=3000

# --- Upload foto menù ---
UPLOADS_DIR=/app/uploads
