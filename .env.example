# Copia questo file in ".env" e valorizza prima di eseguire "docker compose up"

# --- Database ---
# Non serve impostare DATABASE_URL separatamente: docker-compose.yml la
# costruisce da queste tre variabili (unica fonte di verità per la
# password, evita che backend e postgres finiscano con credenziali
# disallineate dopo un redeploy).
POSTGRES_USER=barmanager
POSTGRES_PASSWORD=change-me
POSTGRES_DB=barmanager

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Cifra le credenziali di integrazioni esterne salvate su database (es. il
# token Loyverse impostato da un locale): qualsiasi stringa va bene, viene
# derivata a una chiave a lunghezza fissa. Cambiarla dopo il primo utilizzo
# rende illeggibili i token già salvati (andrebbero re-inseriti).
SECRET_ENCRYPTION_KEY=change-me-secret-encryption-key

# --- SMTP (invio ordini/notifiche) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Opzionale: normalmente dedotto dalla porta (465=true, altrimenti false).
# Da impostare solo se il provider richiede una combinazione non standard.
# SMTP_SECURE=true
SMTP_USER=ordini@example.com
# SMTP_PASS è accettata come alias equivalente, se preferisci quel nome.
SMTP_PASSWORD=change-me
# Mittente di riserva se il locale non ha impostato una propria email in
# Impostazioni locale (quella, se presente, ha sempre la precedenza).
SMTP_FROM="BarManager <ordini@example.com>"

# --- LocationIQ (geocodifica indirizzo di consegna, §5.10) ---
# Chiave gratuita da locationiq.com (piano free, uso commerciale permesso).
# Senza questa variabile il pulsante "Cerca" nel checkout consegna non
# trova mai l'indirizzo e non posiziona il puntatore sulla mappa.
LOCATIONIQ_API_KEY=

# --- Multi-tenant (sotto-domini) ---
# In locale/sviluppo lascia ROOT_DOMAIN vuoto: il TenantMiddleware diventa
# no-op e login/menù funzionano senza sotto-domini (utile con localhost).
# In produzione, usata a runtime dal backend (TenantMiddleware) per
# riconoscere il locale dal sotto-dominio — impostala comunque:
# ROOT_DOMAIN=tuodominio.it
#
# ATTENZIONE: il ROUTING Traefik (label del servizio "frontend" in
# docker-compose.yml) NON legge questa variabile — verificato che Coolify
# non interpola in modo affidabile le variabili dentro "labels:", quindi
# lì il dominio è scritto a mano. Se cambi dominio, valorizza questa
# variabile qui E modifica anche le label in docker-compose.yml.
ROOT_DOMAIN=
ADMIN_SUBDOMAIN=admin

# Base URL usata SOLO dal backend per costruire il link "Accetta/Rifiuta"
# nell'email di prenotazione mandata al locale, quando ROOT_DOMAIN è vuoto
# (sviluppo locale): con ROOT_DOMAIN impostato si usa invece il
# sotto-dominio del locale e questa variabile è ignorata.
PUBLIC_APP_URL=http://localhost:5173

# --- Frontend ---
# Lascia vuoto: il frontend chiama l'API in modo relativo ("/api"), instradata
# dallo stesso proxy (Nginx/Vite) che serve la SPA. Valorizza solo per
# puntare a un backend su un altro host (raro).
VITE_API_URL=

# --- App ---
NODE_ENV=development
PORT=3000

# --- Upload foto menù ---
UPLOADS_DIR=/app/uploads
