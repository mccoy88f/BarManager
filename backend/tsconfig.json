{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "node",
    "esModuleInterop": true
  },
  // Senza "include", tsc raccoglie anche prisma/seed.ts (fuori da src/,
  // eseguito a parte via ts-node): la radice comune diventa la root del
  // progetto e l'output finisce sotto dist/src/... invece che dist/...,
  // rompendo "node dist/main" (package.json "start" e Dockerfile CMD).
  "include": ["src/**/*.ts"]
}
