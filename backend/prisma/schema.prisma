generator client {
  provider      = "prisma-client-js"
  // "native" per lo sviluppo fuori Docker (macOS/Linux glibc); il target
  // musl esplicito serve per i container node:20-alpine (Dockerfile),
  // così l'engine giusto viene scaricato anche se l'auto-detect di
  // OpenSSL nel container dovesse fallire.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core / Auth
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN // gestore della piattaforma: crea/sospende i locali, nessun venueId
  ADMIN
  MANAGER
  EMPLOYEE
}

/// Un locale/azienda, isolato dagli altri (multi-tenant) e raggiungibile
/// sul proprio sotto-dominio (`slug`.tuodominio.it). Creato dal Super Admin.
model Venue {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // sotto-dominio, es. "locale1" -> locale1.tuodominio.it
  active    Boolean  @default(true) // sospensione locale (mancato pagamento, ecc.)
  createdAt DateTime @default(now())

  // Email del locale: usata come mittente delle email di ordine ai
  // fornitori (invece di dover impostare SMTP_FROM via variabile
  // d'ambiente). Se assente si ricade su SMTP_FROM.
  email String?

  // Fuso orario IANA (es. "Europe/Rome") usato per ogni calcolo di "oggi"/
  // giorno della settimana/orario riferito al locale: validazione orario
  // prenotazioni, fascia pranzo/cena del menù, fornitori da ordinare oggi,
  // periodo corrente delle pulizie HACCP, range data dei report HACCP.
  // Il processo Node gira in UTC (o nel fuso del server, comunque non
  // legato al locale): senza questo campo tutti quei calcoli userebbero
  // implicitamente quel fuso invece di quello reale del locale.
  timezone String @default("Europe/Rome")

  // Orari di apertura settimanali del locale: un array di 7 giorni
  // (0=domenica..6=sabato, come Date#getDay()), ciascuno "chiuso" oppure
  // aperto con una o due fasce orarie (es. pranzo+cena, con pausa fra le
  // due). Usati sia dal menù pubblico (voci "solo pranzo"/"solo cena")
  // sia dal modulo Prenotazioni (§5.7) per validare l'orario richiesto.
  // Se null, non ancora configurato: si usa il default (aperto tutti i
  // giorni, 12:00-15:00 e 19:00-23:00) calcolato in codice, vedi
  // backend/src/common/opening-hours/opening-hours.ts.
  openingHours Json?

  // Aspetto del menù pubblico: immagine di copertina in alto e informazioni
  // di contatto in fondo (social, telefono), impostati dall'admin.
  menuCoverUrl     String?
  menuAddress      String?
  menuPhone        String?
  menuInstagramUrl String?
  menuFacebookUrl  String?
  menuWebsiteUrl   String?

  // Dati identificativi del locale, non specifici al menù pubblico: usati
  // nell'intestazione delle email di ordine ai fornitori (§11) insieme a
  // nome e indirizzo, oltre a un possibile uso futuro in fattura.
  city      String?
  vatNumber String?

  // Logo del locale, mostrato in alto nelle email inviate ai clienti
  // (prenotazioni): distinto dalla copertina del menù, pensato per un
  // marchio/logo vero e proprio più adatto a un'intestazione email.
  logoUrl String?

  // Colore di accento scelto dall'admin in Impostazioni (esadecimale, es.
  // "#1E5F74"): diventa il colore primario del tema (barra in alto, pulsanti,
  // icone della navigazione laterale) e dello stesso "theme-color" della PWA.
  // null = non ancora personalizzato, si usa il colore di default del tema.
  themeAccentColor String?

  // Integrazione Loyverse: quando attiva, categorie/voci/prezzi/immagini del
  // menù arrivano da Loyverse (fonte unica per il catalogo) e in BarManager
  // si gestisce solo la visibilità/disponibilità online — niente aggiunte o
  // modifiche manuali di categorie/voci (v. menu.service.ts). Il token è
  // sempre cifrato (v. common/crypto/secret-crypto.ts), mai in chiaro come
  // le altre impostazioni.
  loyverseIntegrationEnabled Boolean   @default(false)
  loyverseAccessTokenEnc     String?
  loyverseLastSyncAt         DateTime?
  loyverseLastSyncError      String?
  // Riepilogo dell'ultima sincronizzazione riuscita (conteggi + eventuali
  // avvisi tipo "voce saltata perché senza categoria mappata"): mostrato
  // nella UI come log, non solo tenuto nei log del server.
  loyverseLastSyncSummary    Json?

  // Metodi di timbratura verificata abilitati dall'admin (più di uno può
  // essere attivo insieme): QR di postazione, posizione GPS entro un raggio
  // dal locale, tag NFC fisico. Se nessuno è abilitato, resta disponibile la
  // timbratura diretta senza verifica (comportamento storico).
  clockInQrEnabled  Boolean @default(true)
  clockInGpsEnabled Boolean @default(false)
  clockInNfcEnabled Boolean @default(false)

  // Punto e raggio (metri) per la timbratura GPS: null finché l'admin non
  // imposta la posizione del locale, anche se clockInGpsEnabled è true.
  gpsLat          Float?
  gpsLng          Float?
  gpsRadiusMeters Int    @default(20)

  // Storico presenze: se il dipendente può vedere le proprie timbrature
  // passate, e se/dopo quanto tempo vanno cancellate automaticamente
  // (nessun valore impostato = mai, comportamento storico).
  attendanceHistoryVisibleToEmployees Boolean                  @default(true)
  attendanceRetentionValue            Int?
  attendanceRetentionUnit             AttendanceRetentionUnit?

  // Prenotazioni tavoli (§5.7 di DEVELOPMENT.md): modulo opzionale,
  // disattivato di default finché l'admin non censisce i tavoli.
  reservationsEnabled              Boolean @default(false)
  // Sopra questa soglia di posti la prenotazione richiede sempre conferma
  // manuale, anche se l'assegnazione automatica del tavolo ha successo.
  reservationAutoConfirmMaxSeats   Int     @default(6)
  // Durata (minuti) per cui una prenotazione occupa il tavolo assegnato:
  // usata per calcolare le sovrapposizioni fra prenotazioni.
  reservationSlotDurationMinutes   Int     @default(120)
  // Quanti giorni in avanti dal momento della richiesta è possibile
  // prenotare dal widget pubblico.
  reservationHorizonDays           Int     @default(30)
  // Tolleranza sul blocco overbooking del widget pubblico: se
  // "unlimited" è true, le richieste non vengono mai bloccate per
  // capienza; altrimenti si accetta di superare la capienza totale dei
  // tavoli attivi fino a "extraSeats" posti in più (0 = blocco rigido,
  // comportamento storico). Non riguarda le prenotazioni aggiunte
  // manualmente in backoffice, che non hanno mai questo vincolo.
  reservationOverbookingUnlimited  Boolean @default(false)
  reservationOverbookingExtraSeats Int     @default(0)
  // Anticipo minimo richiesto per prenotare dal widget pubblico (minuti
  // da adesso): es. 30 impedisce di prenotare per un orario a meno di
  // 30 minuti da ora. 0 = nessun vincolo (comportamento storico). Non
  // si applica all'aggiunta manuale in backoffice.
  reservationMinLeadMinutes        Int     @default(0)

  // Ordini online (§5.10 di DEVELOPMENT.md): asporto e consegna a domicilio
  // dal menù pubblico, modulo opzionale come le prenotazioni.
  onlineOrdersEnabled         Boolean @default(false)
  onlineOrdersPickupEnabled   Boolean @default(true)
  onlineOrdersDeliveryEnabled Boolean @default(true)
  // Orari specifici per gli ordini online, stessa forma di "openingHours"
  // sopra: se null si usano gli orari generali del locale. Il primo/ultimo
  // orario richiedibile è comunque sempre ristretto di 30 minuti su
  // ciascun lato della fascia (margine fisso, non configurabile — v.
  // isWithinOnlineOrdersWindow in common/opening-hours/opening-hours.ts).
  onlineOrdersOpeningHours    Json?
  // Anticipo minimo richiesto dal checkout pubblico (minuti da adesso),
  // equivalente a reservationMinLeadMinutes ma un valore proprio: il tempo
  // di preparazione di un ordine non è quello di un tavolo.
  onlineOrdersMinLeadMinutes  Int     @default(30)

  // Accettazione automatica per fascia da 15 minuti di "requestedAt": se
  // attiva, un ordine sotto soglia nasce già CONFIRMED (salta PENDING).
  // La soglia non blocca mai l'invio dell'ordine, solo se saltare o no la
  // revisione manuale (v. §5.10). "SlotMode" sceglie se la soglia è un
  // unico contatore condiviso ritiro+consegna, o due contatori separati.
  onlineOrdersAutoAcceptEnabled         Boolean              @default(false)
  onlineOrdersAutoAcceptSlotMode        OnlineOrdersSlotMode @default(COMBINED)
  onlineOrdersAutoAcceptPerSlot         Int                  @default(0)
  onlineOrdersAutoAcceptPerSlotPickup   Int                  @default(0)
  onlineOrdersAutoAcceptPerSlotDelivery Int                  @default(0)

  // Zona e costo di consegna: raggio massimo dal locale (null = nessun
  // limite, calcolato con la stessa formula haversine della timbratura
  // GPS a partire da gpsLat/gpsLng sopra), costo fisso e soglia di importo
  // ordine sopra la quale la consegna è gratuita (null = mai gratuita).
  deliveryRadiusMeters    Int?
  deliveryFee             Float  @default(0)
  deliveryFreeAboveAmount Float?

  // Integrazione SumUp (Online Payments API, §5.10): credenziali e metodi
  // di pagamento abilitati dall'admin per la consegna, cifrate come il
  // token Loyverse sopra.
  sumupEnabled               Boolean  @default(false)
  sumupApiKeyEnc             String?
  // Sottoinsieme scelto dall'admin tra i metodi davvero disponibili per il
  // proprio account (interrogati con "Verifica metodi disponibili", es.
  // ["card", "bancomat_pay"]) — non tutti quelli che SumUp offrirebbe.
  sumupEnabledPaymentMethods String[] @default([])

  // Sincronizzazione Loyverse degli ordini online: opt-in separato da
  // loyverseIntegrationEnabled sopra (un locale può avere Loyverse attivo
  // per il menù ma non volerlo per gli ordini online). Mappatura dei 3
  // metodi di pagamento di BarManager sul payment_type_id configurato dal
  // locale nel proprio Back Office Loyverse (GET /payment-types) — non
  // correlata a sumupEnabledPaymentMethods sopra, un asse indipendente.
  loyverseSyncOnlineOrders         Boolean @default(false)
  loyversePaymentTypeIdCash        String?
  loyversePaymentTypeIdCardOnline  String?
  loyversePaymentTypeIdCardInStore String?

  users              User[]
  employees          Employee[]
  fridges            Fridge[]
  cleaningTasks      CleaningTask[]
  printers           Printer[]
  productCategories  ProductCategory[]
  suppliers          Supplier[]
  orders             Order[]
  auditLogs          AuditLog[]
  qrTokens           QrToken[]
  nfcTags            NfcTag[]
  haccpReports       HaccpReport[]
  menuCategories     MenuCategory[]
  menuItems          MenuItem[]
  menuModifierGroups MenuModifierGroup[]
  tasks              Task[]
  boardMessages      BoardMessage[]
  kbArticles         KbArticle[]
  tables             Table[]
  reservations       Reservation[]
  customers          Customer[]
  communications     Communication[]
  onlineOrders       OnlineOrder[]
}

enum OnlineOrdersSlotMode {
  COMBINED
  SEPARATE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  // null solo per SUPER_ADMIN: è trasversale, non appartiene a un locale
  venueId String?
  venue   Venue?  @relation(fields: [venueId], references: [id])

  employee Employee?

  reviewedLeaveRequests LeaveRequest[]       @relation("LeaveReviewedBy")
  temperatureReadings   TemperatureReading[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  tasksAssigned         Task[]               @relation("TaskAssignedTo")
  tasksCreated          Task[]               @relation("TaskCreatedBy")
  boardMessages         BoardMessage[]
  kbArticles            KbArticle[]
  ordersCreated         Order[]
  cleaningLogs          CleaningLog[]
  reservationsHandled   Reservation[]        @relation("ReservationRespondedBy")
  communicationsCreated Communication[]
}

// ---------------------------------------------------------------------------
// Presenze dipendenti
// ---------------------------------------------------------------------------

model Employee {
  id         String    @id @default(cuid())
  firstName  String
  lastName   String
  role       String? // mansione (es. "Cameriere", "Cuoco")
  department String? // reparto, usato anche per CC ordini/approvazioni
  email      String? // email di contatto (usata per CC ordini se non ha un account utente)
  phone      String?
  hiredAt    DateTime?
  isManager  Boolean   @default(false) // responsabile di reparto (CC ordini, approvazione ferie del team)
  active     Boolean   @default(true)

  // Moduli extra a cui il dipendente può accedere (es. "haccp", "inventory",
  // "menu", "tasks"), indipendentemente dal ruolo: impostati dall'admin
  // nella scheda del dipendente. Array vuoto = fallback ai permessi di
  // default del ruolo (MANAGER: tutti; EMPLOYEE: solo HACCP), per non
  // rompere il comportamento dei dipendenti già esistenti mai configurati.
  allowedModules String[] @default([])

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  attendanceRecords AttendanceRecord[]
  leaveRequests     LeaveRequest[]
  relatedTasks      Task[]
  cleaningLogs      CleaningLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QrToken {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  label     String // es. "Ingresso cucina"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  attendanceRecords AttendanceRecord[]
}

// Tag NFC fisico: l'admin definisce qui etichetta e testo (plain text), poi
// scrive lo stesso testo sul tag fisico con un'app di terze parti (BarManager
// non scrive NFC, solo legge e confronta al momento della timbratura).
model NfcTag {
  id        String   @id @default(cuid())
  label     String // es. "Ingresso cucina"
  value     String   @unique // testo scritto sul tag fisico
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  attendanceRecords AttendanceRecord[]
}

enum AttendanceType {
  CLOCK_IN
  CLOCK_OUT
}

enum AttendanceSource {
  QR
  GPS
  NFC
  MANUAL
  CORRECTION
  SELF_REPORTED // "Ho dimenticato di timbrare": inserita dal dipendente, in attesa di conferma admin
}

enum AttendanceApprovalStatus {
  CONFIRMED // timbratura verificata in tempo reale (QR/GPS/NFC) o inserita dall'admin
  PENDING // dichiarata dal dipendente stesso: non conta nei totali finché l'admin non la conferma
  REJECTED
}

enum AttendanceRetentionUnit {
  DAYS
  MONTHS
  YEARS
}

model AttendanceRecord {
  id             String                   @id @default(cuid())
  type           AttendanceType
  timestamp      DateTime                 @default(now())
  source         AttendanceSource         @default(QR)
  approvalStatus AttendanceApprovalStatus @default(CONFIRMED)
  note           String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  qrTokenId String?
  qrToken   QrToken? @relation(fields: [qrTokenId], references: [id])

  nfcTagId String?
  nfcTag   NfcTag? @relation(fields: [nfcTagId], references: [id])

  // Coordinate inviate dal client per una timbratura GPS (audit/verifica a
  // posteriori), non usate per il calcolo che resta lato server al momento.
  gpsLat Float?
  gpsLng Float?

  correctedById String? // userId dell'admin che ha corretto il record
  reviewedById  String? // userId dell'admin che ha approvato/rifiutato una segnalazione del dipendente
  createdAt     DateTime @default(now())

  @@index([employeeId, timestamp])
}

enum LeaveType {
  VACATION
  PERMIT
  SICKNESS
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id         String      @id @default(cuid())
  type       LeaveType
  startDate  DateTime
  endDate    DateTime
  partialDay Boolean     @default(false)
  startTime  String? // "HH:mm", solo se partialDay
  endTime    String? // "HH:mm", solo se partialDay
  note       String?
  status     LeaveStatus @default(PENDING)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  reviewedById String?
  reviewedBy   User?     @relation("LeaveReviewedBy", fields: [reviewedById], references: [id])
  reviewNote   String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// HACCP
// ---------------------------------------------------------------------------

model Fridge {
  id       String  @id @default(cuid())
  label    String // es. "Frigo 1 - Bancone"
  location String?
  minTemp  Float // soglia minima accettabile (°C)
  maxTemp  Float // soglia massima accettabile (°C)
  active   Boolean @default(true)

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  readings TemperatureReading[]

  createdAt DateTime @default(now())
}

model TemperatureReading {
  id               String   @id @default(cuid())
  value            Float
  recordedAt       DateTime @default(now())
  outOfRange       Boolean  @default(false)
  correctiveAction String?

  fridgeId String
  fridge   Fridge @relation(fields: [fridgeId], references: [id])

  recordedById String
  recordedBy   User   @relation(fields: [recordedById], references: [id])

  @@index([fridgeId, recordedAt])
}

/// Istanza di report giornaliero HACCP generato/stampato/firmato.
/// Le temperature del giorno restano comunque in TemperatureReading;
/// questo modello traccia solo la "chiusura" del report (chi firma, quando).
model HaccpReport {
  id           String   @id @default(cuid())
  reportDate   DateTime // giorno a cui si riferisce il report (senza ora)
  signedByName String // nome di chi appone la firma
  signatureImg String? // firma digitale (immagine base64), opzionale
  printedOnPos Boolean  @default(false)
  createdAt    DateTime @default(now())

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  @@index([venueId, reportDate])
}

/// Unità di ricorrenza di una voce di pulizia: combinata con `timesPerUnit`
/// copre "giornaliera" (DAY,1), "più volte al giorno" (DAY,>1), "settimanale"
/// (WEEK,1), "più volte a settimana" (WEEK,>1), "mensile" (MONTH,1) e
/// "più volte al mese" (MONTH,>1).
enum CleaningFrequencyUnit {
  DAY
  WEEK
  MONTH
}

/// Voce di pulizia ricorrente censita dall'admin (es. "Sgrassare friggitrice"
/// in "Cucina", ogni giorno). Le esecuzioni effettive sono in CleaningLog.
model CleaningTask {
  id            String                @id @default(cuid())
  description   String
  location      String
  frequencyUnit CleaningFrequencyUnit
  timesPerUnit  Int                   @default(1)
  active        Boolean               @default(true)

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  logs CleaningLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Un'esecuzione registrata di una voce di pulizia: chi l'ha fatta e quando.
/// Chi la registra è sempre un User (come TemperatureReading.recordedBy):
/// l'Employee è solo un riferimento in più per mostrare nome/cognome quando
/// c'è, ma admin/responsabili senza una scheda dipendente devono poter
/// segnare comunque una pulizia come fatta.
model CleaningLog {
  id          String   @id @default(cuid())
  completedAt DateTime @default(now())

  taskId String
  task   CleaningTask @relation(fields: [taskId], references: [id])

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  // Opzionale per non rompere le righe già registrate prima di questo
  // campo: le nuove esecuzioni lo impostano sempre (complete() in
  // cleaning.service.ts).
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([taskId, completedAt])
}

// ---------------------------------------------------------------------------
// Stampanti
// ---------------------------------------------------------------------------

enum PrinterUsage {
  HACCP
  ORDERS
  GENERIC
}

model Printer {
  id     String         @id @default(cuid())
  name   String
  host   String // IP di rete
  port   Int            @default(9100)
  // Una stampante può servire più usi insieme (es. HACCP e ordini sulla
  // stessa stampante di sala). Migrato da un valore singolo "usage": v.
  // prisma/scripts/auto-migrate-printer-usages.ts.
  usages PrinterUsage[] @default([GENERIC])
  active Boolean        @default(true)

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Inventario e ordini
// ---------------------------------------------------------------------------

model ProductCategory {
  id     String  @id @default(cuid())
  name   String
  active Boolean @default(true)

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  products Product[]

  createdAt DateTime @default(now())

  @@unique([venueId, name])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  email     String
  ccEmails  String[] @default([]) // email extra fisse (oltre ai responsabili reparto)
  phone     String?
  active    Boolean  @default(true)
  // Giorni della settimana in cui va fatto l'ordine (1=lunedì .. 7=domenica),
  // impostati dall'admin ("impostazioni"): usati per il promemoria in home.
  orderDays Int[]    @default([])

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  products Product[]
  orders   Order[]

  createdAt DateTime @default(now())
}

model Product {
  id              String  @id @default(cuid())
  name            String
  unit            String // es. "pz", "kg", "cartone da 6"
  standardQty     Float // scorta standard/obiettivo
  reorderAt       Float? // soglia minima sotto la quale segnalare urgenza
  supplierCode    String? // codice prodotto presso il fornitore
  costPerUnit     Float? // costo unitario per collo/unità, opzionale: usato per il totale ordine
  // Quante unità/porzioni singole contiene una unità d'acquisto (es. un
  // cartone di birre contiene 24 lattine): puramente informativo, non
  // entra nei calcoli di scorta/ordine che restano espressi in "unit".
  unitsPerPackage Int?
  active          Boolean @default(true)

  categoryId String
  category   ProductCategory @relation(fields: [categoryId], references: [id])

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  orderLines OrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  DRAFT
  SENT
  CONFIRMED
  CLOSED
}

model Order {
  id     String      @id @default(cuid())
  status OrderStatus @default(DRAFT)

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  lines OrderLine[]

  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  sentAt      DateTime?
  // Esito dell'invio email al fornitore al momento di sentAt: null finché
  // l'ordine è ancora una bozza. L'ordine passa comunque a SENT anche se
  // l'email fallisce (l'admin può comunque averlo consegnato a voce/con
  // altro mezzo), ma l'esito resta visibile nello storico invece di
  // perdersi dopo il toast immediato.
  emailSent   Boolean?
  emailError  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model OrderLine {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  stockOnHand  Float // giacenza rilevata al momento dell'ordine
  suggestedQty Float // calcolata: max(0, standardQty - stockOnHand)
  orderedQty   Float // quantità effettiva ordinata (editabile dall'utente)
}

// ---------------------------------------------------------------------------
// Menù online
// ---------------------------------------------------------------------------

/// I 14 allergeni ad indicazione obbligatoria (Reg. UE 1169/2011).
enum Allergen {
  GLUTEN
  CRUSTACEANS
  EGGS
  FISH
  PEANUTS
  SOYBEANS
  MILK
  NUTS
  CELERY
  MUSTARD
  SESAME
  SULPHITES
  LUPIN
  MOLLUSCS
}

enum MenuAvailability {
  LUNCH
  DINNER
  ALL_DAY
}

model MenuCategory {
  id        String  @id @default(cuid())
  name      String
  sortOrder Int     @default(0)
  visible   Boolean @default(true) // mostra/nascondi dal menù pubblico, come le voci di menù

  // Popolata solo dal sync Loyverse: chiave per aggiornare la categoria
  // senza duplicarla ai sync successivi, mai impostata a mano.
  loyverseCategoryId String?

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  items MenuItem[]

  createdAt DateTime @default(now())

  @@unique([venueId, name])
  @@unique([venueId, loyverseCategoryId])
}

model MenuItem {
  id          String     @id @default(cuid())
  name        String
  description String?
  photoUrl    String?
  allergens   Allergen[] @default([])

  availability MenuAvailability @default(ALL_DAY)

  visible          Boolean   @default(true) // mostra/nascondi dal menù pubblico
  unavailableUntil DateTime? // "esaurito fino a": nel menù ma non ordinabile finché non passa
  // In evidenza in cima al menù pubblico, in aggiunta alla propria categoria.
  featured         Boolean   @default(false)

  // Canale "ordini online" (§5.10 di DEVELOPMENT.md): flag di
  // presentazione/canale come "visible"/"featured" sopra, quindi sempre
  // modificabile anche con l'integrazione Loyverse attiva. Il "menù
  // locale" (pagina /menu) non ne tiene conto: mostra sempre tutte le voci
  // visibili, indipendentemente da questo flag.
  orderableOnline Boolean @default(false)

  sortOrder Int @default(0)

  // Popolata solo dal sync Loyverse: raggruppa le varianti di uno stesso
  // prodotto Loyverse sotto questa voce di menù, mai impostata a mano.
  loyverseItemId String?

  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id])

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  variants       MenuItemVariant[]
  modifierGroups MenuItemModifierGroup[]
  orderLines     OnlineOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, loyverseItemId])
  @@index([venueId, categoryId])
}

/// Prezzo di una voce di menù: quasi sempre una sola riga ("" come nome,
/// prezzo unico), più righe quando il prodotto ha formati/taglie diverse
/// (es. "Piccola" €3.50 / "Grande" €5.00) — a mano o sincronizzate da una
/// voce Loyverse con più varianti.
model MenuItemVariant {
  id     String  @id @default(cuid())
  name   String  @default("")
  // null = prezzo variabile (deciso manualmente in cassa, o a peso): la
  // voce resta comunque nel menù, mostrata senza importo.
  price  Float?
  active Boolean @default(true)

  sortOrder Int @default(0)

  // Popolata solo dal sync Loyverse.
  loyverseVariantId String?

  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  orderLines OnlineOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([menuItemId, loyverseVariantId])
}

// ---------------------------------------------------------------------------
// Modificatori del menù (§5.10 di DEVELOPMENT.md): asse ortogonale alle
// Varianti sopra (es. "Estras": +Formaggio, -Cipolla, applicabili a più voci
// diverse), nativi come le Varianti — funzionano anche senza Loyverse, si
// popolano dal sync (GET /modifiers) solo quando l'integrazione è attiva.
// ---------------------------------------------------------------------------

enum MenuModifierSelectionType {
  SINGLE
  MULTIPLE
}

model MenuModifierGroup {
  id            String                    @id @default(cuid())
  name          String // es. "Estras"
  selectionType MenuModifierSelectionType @default(SINGLE)
  minSelections Int                       @default(0)
  maxSelections Int?
  sortOrder     Int                       @default(0)

  // Popolata solo dal sync Loyverse, mai impostata a mano.
  loyverseModifierId String?

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  options MenuModifierOption[]
  items   MenuItemModifierGroup[]

  createdAt DateTime @default(now())

  @@unique([venueId, loyverseModifierId])
}

model MenuModifierOption {
  id        String @id @default(cuid())
  name      String // es. "Formaggio extra"
  price     Float  @default(0) // può essere 0, es. "Senza cipolla"
  sortOrder Int    @default(0)

  // Popolata solo dal sync Loyverse.
  loyverseModifierOptionId String?

  groupId String
  group   MenuModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  lineModifiers OnlineOrderLineModifier[]

  createdAt DateTime @default(now())
}

/// Quali gruppi di modificatori si applicano a quale voce di menù (molti-a-
/// molti): un gruppo "Estras" può essere condiviso da più voci diverse,
/// esattamente come Item.modifier_ids in Loyverse.
model MenuItemModifierGroup {
  menuItemId      String
  modifierGroupId String
  menuItem        MenuItem          @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup   MenuModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([menuItemId, modifierGroupId])
  @@index([modifierGroupId])
}

// ---------------------------------------------------------------------------
// Attività e scadenze
// ---------------------------------------------------------------------------

enum TaskType {
  GENERIC
  SUPPLIER_PAYMENT // pagamento fornitori
  EMPLOYEE_MEDICAL_VISIT // visita medica dipendenti
  CERTIFICATE_EXPIRY // scadenza attestati/corsi
  MAINTENANCE // manutenzioni attrezzature
}

enum TaskStatus {
  OPEN
  DONE
}

/// Ricorrenza per scadenze periodiche (es. attestato da rinnovare ogni
/// anno): al completamento viene generata automaticamente l'occorrenza
/// successiva con la stessa scadenza spostata in avanti.
enum TaskRecurrence {
  NONE
  WEEKLY
  MONTHLY
  YEARLY
}

model Task {
  id                 String         @id @default(cuid())
  title              String
  description        String?
  type               TaskType       @default(GENERIC)
  status             TaskStatus     @default(OPEN)
  dueDate            DateTime
  reminderDaysBefore Int            @default(7) // da quanti giorni prima segnalarla come imminente in home
  recurrence         TaskRecurrence @default(NONE)
  completedAt        DateTime?

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  // Dipendente collegato (es. di chi è la visita medica/l'attestato)
  relatedEmployeeId String?
  relatedEmployee   Employee? @relation(fields: [relatedEmployeeId], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("TaskAssignedTo", fields: [assignedToId], references: [id])

  createdById String
  createdBy   User   @relation("TaskCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId, status, dueDate])
}

// ---------------------------------------------------------------------------
// Audit & notifiche
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  entity    String // es. "AttendanceRecord", "TemperatureReading"
  entityId  String
  action    String // "CREATE" | "UPDATE" | "DELETE"
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
}

// ---------------------------------------------------------------------------
// Bacheca
// ---------------------------------------------------------------------------

/// Messaggio di bacheca creato dall'admin: se pinnato compare subito in home,
/// altrimenti solo nell'elenco completo. Foto opzionale, ingrandibile in un
/// modale al click.
model BoardMessage {
  id       String  @id @default(cuid())
  text     String
  photoUrl String?
  pinned   Boolean @default(false)

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId, pinned, createdAt])
}

// ---------------------------------------------------------------------------
// KBpedia
// ---------------------------------------------------------------------------

/// Articolo della knowledge base interna: testo ricco (HTML sanificato lato
/// server) con foto e/o video incorporati, scritto dall'admin e visibile a
/// tutti i dipendenti del locale.
model KbArticle {
  id          String @id @default(cuid())
  title       String
  contentHtml String

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId, createdAt])
}

enum NotificationType {
  LEAVE_REQUEST_PENDING
  LEAVE_REQUEST_REVIEWED
  TEMPERATURE_OUT_OF_RANGE
  STOCK_LOW
  ORDER_SENT
  RESERVATION_PENDING
  RESERVATION_BLOCKED
  RESERVATION_TIME_CONFIRMED
  RESERVATION_CANCELLED_BY_CUSTOMER
}

model Notification {
  id      String           @id @default(cuid())
  type    NotificationType
  message String
  read    Boolean          @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Prenotazioni tavoli (§5.7 di DEVELOPMENT.md)
// ---------------------------------------------------------------------------

/// Tavolo censito dall'admin. "active: false" lo ritira dalle nuove
/// prenotazioni senza perdere lo storico di quelle già assegnate.
model Table {
  id     String  @id @default(cuid())
  label  String // numero o nome, es. "12" o "Terrazza 2"
  seats  Int
  active Boolean @default(true)

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  reservations ReservationTable[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
}

/// Assegnazione di un tavolo a una prenotazione: relazione molti-a-molti
/// esplicita (non più un semplice tableId singolo) perché un gruppo grande
/// può occupare più tavoli contemporaneamente, accostati manualmente
/// dall'admin (§10 di DEVELOPMENT.md — prima non modellato, un solo tavolo
/// per prenotazione). onDelete Cascade su entrambi i lati: se la
/// prenotazione o il tavolo vengono eliminati, l'assegnazione decade con
/// loro senza lasciare righe orfane.
model ReservationTable {
  reservationId String
  tableId       String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  table         Table       @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@id([reservationId, tableId])
  @@index([tableId])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

/// Richiesta di prenotazione da parte di un cliente (widget pubblico,
/// nessun login). Isolata per venueId come tutte le altre entità.
model Reservation {
  id                   String            @id @default(cuid())
  firstName            String
  lastName             String
  email                String
  phone                String
  partySize            Int
  reservedAt           DateTime // data/ora confermata (quella richiesta, salvo cambio orario concordato)
  // Nuovo orario proposto dal locale (§10 di DEVELOPMENT.md), in attesa di
  // conferma del cliente via email: se presente, "reservedAt" resta quello
  // valido finché il cliente non confema il cambio dal link email.
  proposedReservedAt   DateTime?
  // Durata di occupazione del tavolo per questa prenotazione, in minuti:
  // se null usa il default del locale (Venue.reservationSlotDurationMinutes).
  // L'admin può alzarla/abbassarla per un singolo gruppo (es. un evento
  // che si sa durerà più a lungo) senza toccare il default per tutti.
  slotDurationMinutes  Int?
  isEvent              Boolean           @default(false)
  eventNote            String? // es. "Compleanno"
  allergiesNote        String?
  notes                String?
  // Consenso a ricevere comunicazioni promozionali (email/SMS/WhatsApp),
  // raccolto con una casella dedicata nel widget di prenotazione — non
  // implicito nell'aver semplicemente prenotato (v. nota GDPR §5.8 di
  // DEVELOPMENT.md). Propagato al Customer corrispondente ad ogni
  // prenotazione (l'ultimo valore dichiarato vince).
  marketingConsent     Boolean           @default(false)
  // Autorizzazione al trattamento dei dati personali (GDPR), obbligatoria
  // per completare la prenotazione dal widget pubblico (v. createPublicReservation
  // in reservations.service.ts, che rifiuta la richiesta se non è true) —
  // non richiesta per l'aggiunta manuale dallo staff. Default true perché
  // obbligatoria da qui in avanti; le righe già esistenti prima di questo
  // campo non riflettono un consenso storico verificato, solo la coerenza
  // dello schema.
  privacyPolicyConsent Boolean           @default(true)
  status               ReservationStatus @default(PENDING)
  // Obbligatoria solo se status = REJECTED.
  rejectionReason      String?
  // Token opaco incluso nel link "Accetta/Rifiuta" mandato all'email del
  // locale: permette di gestire la richiesta senza login (§5.7). Non è
  // derivabile dall'id della prenotazione.
  manageToken          String            @unique

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  tables ReservationTable[]

  respondedById String?
  respondedBy   User?     @relation("ReservationRespondedBy", fields: [respondedById], references: [id])
  respondedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId, reservedAt])
}

/// Anagrafica clienti (§5.8 di DEVELOPMENT.md): creata/aggiornata in automatico
/// a ogni prenotazione (widget pubblico o aggiunta manuale), ma modificabile
/// anche a mano dall'admin (CRUD dedicato). "firstReservationAt" è la data di
/// prima prenotazione (usata come "registrazione" del cliente),
/// "lastReservationAt" quella della più recente (pensata anche come proxy di
/// aggiornamento consensi per future campagne marketing — non implica da sola
/// un consenso esplicito, v. nota GDPR in DEVELOPMENT.md). Isolata per
/// venueId, unica per email nello stesso locale.
model Customer {
  id                 String    @id @default(cuid())
  firstName          String
  lastName           String
  email              String
  phone              String?
  notes              String?
  firstReservationAt DateTime?
  lastReservationAt  DateTime?
  reservationsCount  Int       @default(0)
  // Equivalenti agli omologhi di prenotazione sopra, ma per gli ordini
  // online (§5.10 di DEVELOPMENT.md): "totalOrdersSpent" è aggiornato in
  // incremento ad ogni OnlineOrder.status -> COMPLETED, non una SUM
  // calcolata al volo ad ogni apertura della pagina Clienti.
  firstOrderAt       DateTime?
  lastOrderAt        DateTime?
  ordersCount        Int       @default(0)
  totalOrdersSpent   Float     @default(0)
  // Ultimo consenso marketing dichiarato dal cliente (v. Reservation.marketingConsent):
  // aggiornato automaticamente ad ogni prenotazione. Non modificabile
  // dall'admin tramite il CRUD di anagrafica (§5.8): solo di sola lettura
  // lì, perché il consenso può essere dato/ritirato solo dal cliente
  // stesso (alla prenotazione, o dalla pagina "gestisci i tuoi dati
  // personali"). Resta invece modificabile in blocco tramite import xlsx,
  // pensato per migrazioni da un altro sistema con consensi già raccolti
  // altrove, non per un cambio dall'admin sulla singola scheda.
  marketingConsent   Boolean   @default(false)
  // Token opaco per la pagina pubblica "gestisci i tuoi dati personali"
  // (link in fondo alle email di prenotazione, §5.8): unico a livello
  // globale (non solo per locale, a differenza di [venueId, email]) perché
  // è l'unico identificativo nel link, senza altro contesto. Generato al
  // bisogno (non alla creazione del cliente) — nullable per non rompere
  // "prisma db push" su righe già esistenti prima di questo campo.
  privacyToken       String?   @unique

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  communicationRecipients CommunicationRecipient[]
  onlineOrders            OnlineOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, email])
  @@index([venueId])
}

// ---------------------------------------------------------------------------
// Marketing/Comunicazioni clienti (§1-septdecies di DEVELOPMENT.md)
// ---------------------------------------------------------------------------

enum CommunicationType {
  // Avviso non promozionale (es. chiusura, cambio orari): può essere
  // inviato a qualunque cliente, indipendentemente dal consenso marketing.
  COMMUNICATION
  // Promozionale: i destinatari selezionabili sono filtrati a monte solo a
  // chi ha marketingConsent = true (v. CommunicationsService.listTargetableCustomers).
  MARKETING
}

enum CommunicationStatus {
  QUEUED // creata, invio ai destinatari non ancora iniziato/in corso
  DONE // tutti i destinatari sono in uno stato finale (SENT o FAILED)
}

enum CommunicationRecipientStatus {
  QUEUED
  SENT
  FAILED
}

/// Un invio massivo lanciato dall'admin dalla pagina Marketing: un record per
/// invio, con un CommunicationRecipient per ciascun cliente destinatario.
/// Isolata per venueId.
model Communication {
  id       String              @id @default(cuid())
  type     CommunicationType
  subject  String
  // HTML compilato dall'editor ricco (stesso editor di KBpedia), con i
  // placeholder ({nome}, {cognome}, {email}) ancora letterali: sostituiti
  // per ciascun destinatario solo al momento dell'invio del suo singolo
  // job, non qui.
  bodyHtml String
  status   CommunicationStatus @default(QUEUED)

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  recipients CommunicationRecipient[]

  createdAt DateTime @default(now())

  @@index([venueId, createdAt])
}

/// Un singolo destinatario di una Communication: lo stato per-cliente,
/// non solo l'esito aggregato dell'invio, per poter capire se una singola
/// email in particolare non è arrivata (v. nota GDPR/§1-septdecies).
model CommunicationRecipient {
  id     String                       @id @default(cuid())
  status CommunicationRecipientStatus @default(QUEUED)
  error  String?
  sentAt DateTime?

  communicationId String
  communication   Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())

  @@index([communicationId, status])
}

// ---------------------------------------------------------------------------
// Ordini online: asporto e consegna a domicilio (§5.10 di DEVELOPMENT.md)
// ---------------------------------------------------------------------------

enum OnlineOrderFulfillment {
  PICKUP
  DELIVERY
}

enum OnlineOrderStatus {
  PENDING // appena arrivato, va accettato/rifiutato — o CONFIRMED subito se accettato in automatico
  CONFIRMED // in preparazione
  READY // pronto per il ritiro, o uscito in consegna
  COMPLETED
  REJECTED // motivo obbligatorio, come Reservation.rejectionReason
  CANCELLED
}

enum OnlineOrderPaymentMethod {
  CASH
  CARD_ONLINE // pagato in anticipo al checkout via SumUp, solo per la consegna
  CARD_IN_STORE // deciso dall'operatore al ritiro fisico, non dal cliente online
}

enum OnlineOrderPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

/// Ordine da asporto o consegna a domicilio dal checkout pubblico /ordina
/// (nessun login). Isolata per venueId come Reservation, cui si ispira per
/// molti pattern (manageToken, proposedRequestedAt, upsert su Customer).
model OnlineOrder {
  id          String                 @id @default(cuid())
  fulfillment OnlineOrderFulfillment
  status      OnlineOrderStatus      @default(PENDING)

  // Orario desiderato di ritiro/consegna, validato ai 15 minuti dentro una
  // fascia di apertura con margine di 30 minuti (v. isWithinOnlineOrdersWindow
  // in common/opening-hours/opening-hours.ts) — non "adesso": anche un
  // ordine "appena possibile" corrisponde comunque a uno slot valido.
  requestedAt         DateTime
  // Nuovo orario proposto dallo staff (tipicamente per spostare un ordine
  // da una fascia satura a una più libera), in attesa di conferma del
  // cliente dalla pagina di tracciamento — stesso pattern di
  // Reservation.proposedReservedAt.
  proposedRequestedAt DateTime?

  firstName String
  lastName  String
  email     String
  phone     String

  // Solo per fulfillment = DELIVERY: indirizzo testuale digitato dal
  // cliente (mostrato in chiaro sullo scontrino completo) e coordinate
  // scelte sulla mappa (origine di verità per distanza/navigazione, non
  // l'indirizzo testuale — v. §5.10).
  deliveryAddress        String?
  deliveryLat            Float?
  deliveryLng            Float?
  deliveryDistanceMeters Float?
  deliveryFee            Float   @default(0)

  subtotal Float // somma delle righe, senza costo di consegna
  total    Float // subtotal + deliveryFee

  // Per il ritiro resta null finché l'operatore non registra a mano come
  // il cliente ha pagato in negozio (v. §5.10) — non è una scelta del
  // cliente online in quel caso, a differenza della consegna.
  paymentMethod      OnlineOrderPaymentMethod?
  paymentStatus      OnlineOrderPaymentStatus  @default(PENDING)
  sumupCheckoutId    String? // solo per paymentMethod = CARD_ONLINE
  sumupTransactionId String?

  marketingConsent     Boolean @default(false)
  privacyPolicyConsent Boolean @default(true)

  // Obbligatoria solo se status = REJECTED.
  rejectionReason String?
  // Token opaco per la pagina pubblica di tracciamento ordine, nessun
  // login — stesso pattern di Reservation.manageToken.
  manageToken     String  @unique

  // Esito della sincronizzazione Loyverse (solo se Venue.loyverseSyncOnlineOrders
  // è attivo): id ricevuta creata, o errore se la mappatura payment_type_id
  // non è configurata — non blocca mai l'ordine reale, v. §5.10.
  loyverseReceiptId String?
  loyverseSyncError String?

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  lines OnlineOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId, status])
  @@index([venueId, requestedAt])
}

/// Riga carrello di un OnlineOrder: nome voce/variante congelati al momento
/// dell'ordine (itemName/variantName), indipendenti da rinomine successive
/// del catalogo — lo stesso principio per cui Reservation porta i propri
/// firstName/lastName invece di dipendere sempre dal Customer collegato.
model OnlineOrderLine {
  id String @id @default(cuid())

  onlineOrderId String
  onlineOrder   OnlineOrder @relation(fields: [onlineOrderId], references: [id], onDelete: Cascade)

  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  itemName   String

  variantId   String
  variant     MenuItemVariant @relation(fields: [variantId], references: [id])
  variantName String

  quantity  Int
  unitPrice Float // prezzo della variante congelato al momento dell'ordine
  note      String? // es. "senza ghiaccio"

  modifiers OnlineOrderLineModifier[]

  @@index([onlineOrderId])
}

/// Modificatore scelto per una riga carrello: nome/prezzo congelati come
/// sopra per OnlineOrderLine.
model OnlineOrderLineModifier {
  id String @id @default(cuid())

  lineId String
  line   OnlineOrderLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  modifierOptionId String
  modifierOption   MenuModifierOption @relation(fields: [modifierOptionId], references: [id])
  optionName       String

  price Float // prezzo del modificatore congelato al momento dell'ordine

  @@index([lineId])
}
