generator client {
  provider = "prisma-client-js"
  // "native" per lo sviluppo fuori Docker (macOS/Linux glibc); il target
  // musl esplicito serve per i container node:20-alpine (Dockerfile),
  // così l'engine giusto viene scaricato anche se l'auto-detect di
  // OpenSSL nel container dovesse fallire.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core / Auth
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN // gestore della piattaforma: crea/sospende i locali, nessun venueId
  ADMIN
  MANAGER
  EMPLOYEE
}

/// Un locale/azienda, isolato dagli altri (multi-tenant) e raggiungibile
/// sul proprio sotto-dominio (`slug`.tuodominio.it). Creato dal Super Admin.
model Venue {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // sotto-dominio, es. "locale1" -> locale1.tuodominio.it
  active    Boolean  @default(true) // sospensione locale (mancato pagamento, ecc.)
  createdAt DateTime @default(now())

  // Fasce orarie del menù, personalizzabili per locale ("HH:mm")
  lunchStart  String @default("12:00")
  lunchEnd    String @default("15:00")
  dinnerStart String @default("19:00")
  dinnerEnd   String @default("23:00")

  // Aspetto del menù pubblico: immagine di copertina in alto e informazioni
  // di contatto in fondo (social, telefono), impostati dall'admin.
  menuCoverUrl      String?
  menuAddress       String?
  menuPhone         String?
  menuInstagramUrl  String?
  menuFacebookUrl   String?
  menuWebsiteUrl    String?

  // Integrazione Loyverse: quando attiva, categorie/voci/prezzi/immagini del
  // menù arrivano da Loyverse (fonte unica per il catalogo) e in BarManager
  // si gestisce solo la visibilità/disponibilità online — niente aggiunte o
  // modifiche manuali di categorie/voci (v. menu.service.ts). Il token è
  // sempre cifrato (v. common/crypto/secret-crypto.ts), mai in chiaro come
  // le altre impostazioni.
  loyverseIntegrationEnabled Boolean   @default(false)
  loyverseAccessTokenEnc     String?
  loyverseLastSyncAt         DateTime?
  loyverseLastSyncError      String?
  // Riepilogo dell'ultima sincronizzazione riuscita (conteggi + eventuali
  // avvisi tipo "voce saltata perché senza categoria mappata"): mostrato
  // nella UI come log, non solo tenuto nei log del server.
  loyverseLastSyncSummary    Json?

  // Metodi di timbratura verificata abilitati dall'admin (più di uno può
  // essere attivo insieme): QR di postazione, posizione GPS entro un raggio
  // dal locale, tag NFC fisico. Se nessuno è abilitato, resta disponibile la
  // timbratura diretta senza verifica (comportamento storico).
  clockInQrEnabled  Boolean @default(true)
  clockInGpsEnabled Boolean @default(false)
  clockInNfcEnabled Boolean @default(false)

  // Punto e raggio (metri) per la timbratura GPS: null finché l'admin non
  // imposta la posizione del locale, anche se clockInGpsEnabled è true.
  gpsLat          Float?
  gpsLng          Float?
  gpsRadiusMeters Int    @default(20)

  users             User[]
  employees         Employee[]
  fridges           Fridge[]
  cleaningTasks     CleaningTask[]
  printers          Printer[]
  productCategories ProductCategory[]
  suppliers         Supplier[]
  orders            Order[]
  auditLogs         AuditLog[]
  qrTokens          QrToken[]
  nfcTags           NfcTag[]
  haccpReports      HaccpReport[]
  menuCategories    MenuCategory[]
  menuItems         MenuItem[]
  tasks             Task[]
  boardMessages     BoardMessage[]
  kbArticles        KbArticle[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  // null solo per SUPER_ADMIN: è trasversale, non appartiene a un locale
  venueId String?
  venue   Venue?  @relation(fields: [venueId], references: [id])

  employee Employee?

  reviewedLeaveRequests   LeaveRequest[]      @relation("LeaveReviewedBy")
  temperatureReadings     TemperatureReading[]
  auditLogs               AuditLog[]
  notifications           Notification[]
  tasksAssigned           Task[]              @relation("TaskAssignedTo")
  tasksCreated            Task[]              @relation("TaskCreatedBy")
  boardMessages           BoardMessage[]
  kbArticles              KbArticle[]
  ordersCreated           Order[]
  cleaningLogs            CleaningLog[]
}

// ---------------------------------------------------------------------------
// Presenze dipendenti
// ---------------------------------------------------------------------------

model Employee {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  role        String? // mansione (es. "Cameriere", "Cuoco")
  department  String? // reparto, usato anche per CC ordini/approvazioni
  email       String? // email di contatto (usata per CC ordini se non ha un account utente)
  phone       String?
  hiredAt     DateTime?
  isManager   Boolean  @default(false) // responsabile di reparto (CC ordini, approvazione ferie del team)
  active      Boolean  @default(true)

  // Moduli extra a cui il dipendente può accedere (es. "haccp", "inventory",
  // "menu", "tasks"), indipendentemente dal ruolo: impostati dall'admin
  // nella scheda del dipendente. Array vuoto = fallback ai permessi di
  // default del ruolo (MANAGER: tutti; EMPLOYEE: solo HACCP), per non
  // rompere il comportamento dei dipendenti già esistenti mai configurati.
  allowedModules String[] @default([])

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  attendanceRecords AttendanceRecord[]
  leaveRequests     LeaveRequest[]
  relatedTasks      Task[]
  cleaningLogs      CleaningLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QrToken {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  label     String // es. "Ingresso cucina"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  attendanceRecords AttendanceRecord[]
}

// Tag NFC fisico: l'admin definisce qui etichetta e testo (plain text), poi
// scrive lo stesso testo sul tag fisico con un'app di terze parti (BarManager
// non scrive NFC, solo legge e confronta al momento della timbratura).
model NfcTag {
  id        String   @id @default(cuid())
  label     String // es. "Ingresso cucina"
  value     String   @unique // testo scritto sul tag fisico
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  attendanceRecords AttendanceRecord[]
}

enum AttendanceType {
  CLOCK_IN
  CLOCK_OUT
}

enum AttendanceSource {
  QR
  GPS
  NFC
  MANUAL
  CORRECTION
  SELF_REPORTED // "Ho dimenticato di timbrare": inserita dal dipendente, in attesa di conferma admin
}

enum AttendanceApprovalStatus {
  CONFIRMED // timbratura verificata in tempo reale (QR/GPS/NFC) o inserita dall'admin
  PENDING // dichiarata dal dipendente stesso: non conta nei totali finché l'admin non la conferma
  REJECTED
}

model AttendanceRecord {
  id             String                   @id @default(cuid())
  type           AttendanceType
  timestamp      DateTime                 @default(now())
  source         AttendanceSource         @default(QR)
  approvalStatus AttendanceApprovalStatus @default(CONFIRMED)
  note           String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  qrTokenId String?
  qrToken   QrToken? @relation(fields: [qrTokenId], references: [id])

  nfcTagId String?
  nfcTag   NfcTag? @relation(fields: [nfcTagId], references: [id])

  // Coordinate inviate dal client per una timbratura GPS (audit/verifica a
  // posteriori), non usate per il calcolo che resta lato server al momento.
  gpsLat Float?
  gpsLng Float?

  correctedById String? // userId dell'admin che ha corretto il record
  reviewedById  String? // userId dell'admin che ha approvato/rifiutato una segnalazione del dipendente
  createdAt     DateTime @default(now())

  @@index([employeeId, timestamp])
}

enum LeaveType {
  VACATION
  PERMIT
  SICKNESS
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id         String      @id @default(cuid())
  type       LeaveType
  startDate  DateTime
  endDate    DateTime
  partialDay Boolean     @default(false)
  startTime  String? // "HH:mm", solo se partialDay
  endTime    String? // "HH:mm", solo se partialDay
  note       String?
  status     LeaveStatus @default(PENDING)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  reviewedById String?
  reviewedBy   User?    @relation("LeaveReviewedBy", fields: [reviewedById], references: [id])
  reviewNote   String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// HACCP
// ---------------------------------------------------------------------------

model Fridge {
  id        String  @id @default(cuid())
  label     String // es. "Frigo 1 - Bancone"
  location  String?
  minTemp   Float // soglia minima accettabile (°C)
  maxTemp   Float // soglia massima accettabile (°C)
  active    Boolean @default(true)

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  readings TemperatureReading[]

  createdAt DateTime @default(now())
}

model TemperatureReading {
  id              String   @id @default(cuid())
  value           Float
  recordedAt      DateTime @default(now())
  outOfRange      Boolean  @default(false)
  correctiveAction String?

  fridgeId String
  fridge   Fridge @relation(fields: [fridgeId], references: [id])

  recordedById String
  recordedBy   User   @relation(fields: [recordedById], references: [id])

  @@index([fridgeId, recordedAt])
}

/// Istanza di report giornaliero HACCP generato/stampato/firmato.
/// Le temperature del giorno restano comunque in TemperatureReading;
/// questo modello traccia solo la "chiusura" del report (chi firma, quando).
model HaccpReport {
  id           String   @id @default(cuid())
  reportDate   DateTime // giorno a cui si riferisce il report (senza ora)
  signedByName String // nome di chi appone la firma
  signatureImg String? // firma digitale (immagine base64), opzionale
  printedOnPos Boolean  @default(false)
  createdAt    DateTime @default(now())

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  @@index([venueId, reportDate])
}

/// Unità di ricorrenza di una voce di pulizia: combinata con `timesPerUnit`
/// copre "giornaliera" (DAY,1), "più volte al giorno" (DAY,>1), "settimanale"
/// (WEEK,1), "più volte a settimana" (WEEK,>1), "mensile" (MONTH,1) e
/// "più volte al mese" (MONTH,>1).
enum CleaningFrequencyUnit {
  DAY
  WEEK
  MONTH
}

/// Voce di pulizia ricorrente censita dall'admin (es. "Sgrassare friggitrice"
/// in "Cucina", ogni giorno). Le esecuzioni effettive sono in CleaningLog.
model CleaningTask {
  id            String                @id @default(cuid())
  description   String
  location      String
  frequencyUnit CleaningFrequencyUnit
  timesPerUnit  Int                   @default(1)
  active        Boolean               @default(true)

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  logs CleaningLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Un'esecuzione registrata di una voce di pulizia: chi l'ha fatta e quando.
/// Chi la registra è sempre un User (come TemperatureReading.recordedBy):
/// l'Employee è solo un riferimento in più per mostrare nome/cognome quando
/// c'è, ma admin/responsabili senza una scheda dipendente devono poter
/// segnare comunque una pulizia come fatta.
model CleaningLog {
  id          String   @id @default(cuid())
  completedAt DateTime @default(now())

  taskId String
  task   CleaningTask @relation(fields: [taskId], references: [id])

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  // Opzionale per non rompere le righe già registrate prima di questo
  // campo: le nuove esecuzioni lo impostano sempre (complete() in
  // cleaning.service.ts).
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([taskId, completedAt])
}

// ---------------------------------------------------------------------------
// Stampanti
// ---------------------------------------------------------------------------

enum PrinterUsage {
  HACCP
  ORDERS
  GENERIC
}

model Printer {
  id     String         @id @default(cuid())
  name   String
  host   String // IP di rete
  port   Int            @default(9100)
  // Una stampante può servire più usi insieme (es. HACCP e ordini sulla
  // stessa stampante di sala). Migrato da un valore singolo "usage": v.
  // prisma/scripts/auto-migrate-printer-usages.ts.
  usages PrinterUsage[] @default([GENERIC])
  active Boolean        @default(true)

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Inventario e ordini
// ---------------------------------------------------------------------------

model ProductCategory {
  id     String  @id @default(cuid())
  name   String
  active Boolean @default(true)

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  products Product[]

  createdAt DateTime @default(now())

  @@unique([venueId, name])
}

model Supplier {
  id           String   @id @default(cuid())
  name         String
  email        String
  ccEmails     String[] @default([]) // email extra fisse (oltre ai responsabili reparto)
  phone        String?
  active       Boolean  @default(true)
  // Giorni della settimana in cui va fatto l'ordine (1=lunedì .. 7=domenica),
  // impostati dall'admin ("impostazioni"): usati per il promemoria in home.
  orderDays    Int[]    @default([])

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  products Product[]
  orders   Order[]

  createdAt DateTime @default(now())
}

model Product {
  id          String  @id @default(cuid())
  name        String
  unit        String // es. "pz", "kg", "cartone da 6"
  standardQty Float // scorta standard/obiettivo
  reorderAt   Float? // soglia minima sotto la quale segnalare urgenza
  supplierCode String? // codice prodotto presso il fornitore
  costPerUnit Float? // costo unitario per collo/unità, opzionale: usato per il totale ordine
  active      Boolean @default(true)

  categoryId String
  category   ProductCategory @relation(fields: [categoryId], references: [id])

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  orderLines OrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  DRAFT
  SENT
  CONFIRMED
  CLOSED
}

model Order {
  id     String      @id @default(cuid())
  status OrderStatus @default(DRAFT)

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  lines OrderLine[]

  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model OrderLine {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  stockOnHand Float // giacenza rilevata al momento dell'ordine
  suggestedQty Float // calcolata: max(0, standardQty - stockOnHand)
  orderedQty   Float // quantità effettiva ordinata (editabile dall'utente)
}

// ---------------------------------------------------------------------------
// Menù online
// ---------------------------------------------------------------------------

/// I 14 allergeni ad indicazione obbligatoria (Reg. UE 1169/2011).
enum Allergen {
  GLUTEN
  CRUSTACEANS
  EGGS
  FISH
  PEANUTS
  SOYBEANS
  MILK
  NUTS
  CELERY
  MUSTARD
  SESAME
  SULPHITES
  LUPIN
  MOLLUSCS
}

enum MenuAvailability {
  LUNCH
  DINNER
  ALL_DAY
}

model MenuCategory {
  id        String  @id @default(cuid())
  name      String
  sortOrder Int     @default(0)
  visible   Boolean @default(true) // mostra/nascondi dal menù pubblico, come le voci di menù

  // Popolata solo dal sync Loyverse: chiave per aggiornare la categoria
  // senza duplicarla ai sync successivi, mai impostata a mano.
  loyverseCategoryId String?

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  items MenuItem[]

  createdAt DateTime @default(now())

  @@unique([venueId, name])
  @@unique([venueId, loyverseCategoryId])
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  photoUrl    String?
  allergens   Allergen[] @default([])

  availability MenuAvailability @default(ALL_DAY)

  visible         Boolean   @default(true) // mostra/nascondi dal menù pubblico
  unavailableUntil DateTime? // "esaurito fino a": nel menù ma non ordinabile finché non passa
  // In evidenza in cima al menù pubblico, in aggiunta alla propria categoria.
  featured Boolean @default(false)

  sortOrder Int @default(0)

  // Popolata solo dal sync Loyverse: raggruppa le varianti di uno stesso
  // prodotto Loyverse sotto questa voce di menù, mai impostata a mano.
  loyverseItemId String?

  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id])

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  variants MenuItemVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId, categoryId])
  @@unique([venueId, loyverseItemId])
}

/// Prezzo di una voce di menù: quasi sempre una sola riga ("" come nome,
/// prezzo unico), più righe quando il prodotto ha formati/taglie diverse
/// (es. "Piccola" €3.50 / "Grande" €5.00) — a mano o sincronizzate da una
/// voce Loyverse con più varianti.
model MenuItemVariant {
  id     String @id @default(cuid())
  name   String @default("")
  // null = prezzo variabile (deciso manualmente in cassa, o a peso): la
  // voce resta comunque nel menù, mostrata senza importo.
  price  Float?
  active Boolean @default(true)

  sortOrder Int @default(0)

  // Popolata solo dal sync Loyverse.
  loyverseVariantId String?

  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([menuItemId, loyverseVariantId])
}

// ---------------------------------------------------------------------------
// Attività e scadenze
// ---------------------------------------------------------------------------

enum TaskType {
  GENERIC
  SUPPLIER_PAYMENT // pagamento fornitori
  EMPLOYEE_MEDICAL_VISIT // visita medica dipendenti
  CERTIFICATE_EXPIRY // scadenza attestati/corsi
  MAINTENANCE // manutenzioni attrezzature
}

enum TaskStatus {
  OPEN
  DONE
}

/// Ricorrenza per scadenze periodiche (es. attestato da rinnovare ogni
/// anno): al completamento viene generata automaticamente l'occorrenza
/// successiva con la stessa scadenza spostata in avanti.
enum TaskRecurrence {
  NONE
  WEEKLY
  MONTHLY
  YEARLY
}

model Task {
  id          String         @id @default(cuid())
  title       String
  description String?
  type        TaskType       @default(GENERIC)
  status      TaskStatus     @default(OPEN)
  dueDate     DateTime
  reminderDaysBefore Int     @default(7) // da quanti giorni prima segnalarla come imminente in home
  recurrence  TaskRecurrence @default(NONE)
  completedAt DateTime?

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  // Dipendente collegato (es. di chi è la visita medica/l'attestato)
  relatedEmployeeId String?
  relatedEmployee   Employee? @relation(fields: [relatedEmployeeId], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("TaskAssignedTo", fields: [assignedToId], references: [id])

  createdById String
  createdBy   User   @relation("TaskCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId, status, dueDate])
}

// ---------------------------------------------------------------------------
// Audit & notifiche
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  entity    String // es. "AttendanceRecord", "TemperatureReading"
  entityId  String
  action    String // "CREATE" | "UPDATE" | "DELETE"
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
}

// ---------------------------------------------------------------------------
// Bacheca
// ---------------------------------------------------------------------------

/// Messaggio di bacheca creato dall'admin: se pinnato compare subito in home,
/// altrimenti solo nell'elenco completo. Foto opzionale, ingrandibile in un
/// modale al click.
model BoardMessage {
  id       String  @id @default(cuid())
  text     String
  photoUrl String?
  pinned   Boolean @default(false)

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId, pinned, createdAt])
}

// ---------------------------------------------------------------------------
// KBpedia
// ---------------------------------------------------------------------------

/// Articolo della knowledge base interna: testo ricco (HTML sanificato lato
/// server) con foto e/o video incorporati, scritto dall'admin e visibile a
/// tutti i dipendenti del locale.
model KbArticle {
  id          String @id @default(cuid())
  title       String
  contentHtml String

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId, createdAt])
}

enum NotificationType {
  LEAVE_REQUEST_PENDING
  LEAVE_REQUEST_REVIEWED
  TEMPERATURE_OUT_OF_RANGE
  STOCK_LOW
  ORDER_SENT
}

model Notification {
  id      String           @id @default(cuid())
  type    NotificationType
  message String
  read    Boolean          @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}
